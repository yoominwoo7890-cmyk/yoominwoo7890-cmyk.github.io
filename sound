<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>음파 간섭 발생기</title>
<style>
:root{
  --paper:#E9EBE5; --panel:#F5F6F2; --line:#CFD5CD;
  --ink:#1E2320; --ink-2:#6A726B;
  --L:#B23A2E; --R:#1D6E6E; --warn:#8A5A00;
  --sans:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Segoe UI",Roboto,"Noto Sans KR",sans-serif;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,"Roboto Mono",monospace;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);
  font-size:15px;line-height:1.5;
  padding:14px 14px calc(30px + env(safe-area-inset-bottom));
  max-width:620px;margin-inline:auto}
h1{font-size:13px;font-weight:500;color:var(--ink-2);margin:0 0 12px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:4px;margin-bottom:10px}
.pad{padding:14px}

/* 위상자 */
#scope{display:block;width:100%;height:180px}
.dphi{display:flex;align-items:baseline;gap:10px;
  padding:0 14px 14px;border-bottom:1px solid var(--line)}
.dphi .k{font-size:11.5px;color:var(--ink-2)}
.dphi .v{font-family:var(--mono);font-size:44px;font-weight:500;line-height:1;
  letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.dphi .tag{margin-left:auto;font-size:12px;color:var(--ink-2);text-align:right;
  align-self:center;line-height:1.4}

/* 재생 버튼 */
.play{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px}
.play button{font-family:var(--sans);font-size:15px;font-weight:500;padding:17px 6px;
  border-radius:4px;border:1px solid var(--line);background:#fff;color:var(--ink);cursor:pointer}
.play button.on{color:#fff;border-color:transparent}
#bL.on{background:var(--L)} #bR.on{background:var(--R)}
#bBoth.on{background:var(--ink)}
.play button.stop{grid-column:1/-1;background:transparent;color:var(--ink-2)}

/* 슬라이더 */
.ctl{padding:14px;border-top:1px solid var(--line)}
.ctl:first-child{border-top:0}
.row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px}
.row .k{font-size:12px;color:var(--ink-2)}
.row .v{font-family:var(--mono);font-size:16px;font-variant-numeric:tabular-nums}
input[type=range]{width:100%;margin:0;accent-color:var(--ink);height:28px}
.chips{display:flex;gap:6px;margin-top:9px;flex-wrap:wrap}
.chips button{font-family:var(--mono);font-size:12px;padding:6px 11px;border-radius:3px;
  border:1px solid var(--line);background:#fff;color:var(--ink-2);cursor:pointer}
.chips button.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}

/* 계산기 */
details{background:var(--panel);border:1px solid var(--line);border-radius:4px;margin-bottom:10px}
summary{padding:11px 14px;font-size:13px;color:var(--ink-2);cursor:pointer;
  list-style:none;display:flex;justify-content:space-between}
summary::-webkit-details-marker{display:none}
summary::after{content:"▾";font-size:11px}
details[open] summary{border-bottom:1px solid var(--line)}
details[open] summary::after{content:"▴"}
.calc{padding:14px}
.calc label{display:block;font-size:12px;color:var(--ink-2);margin-bottom:5px}
.calc input[type=number]{width:100%;font-family:var(--mono);font-size:17px;padding:9px 10px;
  border:1px solid var(--line);border-radius:4px;background:#fff;color:var(--ink)}
.out{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);
  display:grid;grid-template-columns:1fr 1fr;gap:12px}
.out b{display:block;font-family:var(--mono);font-size:19px;font-weight:500;
  font-variant-numeric:tabular-nums}
.out span{font-size:11.5px;color:var(--ink-2)}

.banner{background:var(--warn);color:#fff;padding:11px 13px;border-radius:4px;
  font-size:13.5px;margin-bottom:10px}
.tip{font-size:12px;color:var(--ink-2);line-height:1.65;margin:14px 2px 0}
.tip b{color:var(--ink);font-weight:500}
</style>
</head>
<body>

<h1>음파 간섭 발생기 · 스피커 2대</h1>
<div id="banner"></div>

<!-- 위상자와 파형 -->
<div class="card">
  <canvas id="scope"></canvas>
  <div class="dphi">
    <div>
      <div class="k">위상차 Δφ</div>
      <div class="v" id="dv">0°</div>
    </div>
    <div class="tag" id="dtag">두 스피커가<br>같은 위상</div>
  </div>
  <div class="play">
    <button id="bL">왼쪽만</button>
    <button id="bR">오른쪽만</button>
    <button id="bBoth">양쪽 동시</button>
    <button class="stop" id="bStop">정지</button>
  </div>
</div>

<!-- 조절 -->
<div class="card">
  <div class="ctl">
    <div class="row"><span class="k">위상차 (오른쪽이 늦음)</span><span class="v" id="pv">0°</span></div>
    <input type="range" id="ph" min="0" max="360" step="1" value="0">
    <div class="chips" id="phChips">
      <button data-p="0">0°</button>
      <button data-p="90">90°</button>
      <button data-p="180">180°</button>
      <button data-p="270">270°</button>
    </div>
  </div>

  <div class="ctl">
    <div class="row"><span class="k">주파수</span><span class="v" id="fv">600 Hz</span></div>
    <input type="range" id="fr" min="400" max="1200" step="10" value="600">
    <div class="chips" id="frChips">
      <button data-f="400">400</button>
      <button data-f="600">600</button>
      <button data-f="800">800</button>
      <button data-f="1000">1000</button>
    </div>
  </div>

  <div class="ctl two">
    <div>
      <div class="row"><span class="k" style="color:var(--L)">왼쪽 음량</span><span class="v" id="lv">70</span></div>
      <input type="range" id="vl" min="0" max="100" step="1" value="70">
    </div>
    <div>
      <div class="row"><span class="k" style="color:var(--R)">오른쪽 음량</span><span class="v" id="rv">70</span></div>
      <input type="range" id="vr" min="0" max="100" step="1" value="70">
    </div>
  </div>
</div>

<!-- 계산기 -->
<details>
  <summary><span>널 간격 계산</span><span id="dyShort">—</span></summary>
  <div class="calc">
    <div class="two">
      <div>
        <label for="dd">스피커 간격 d (m)</label>
        <input type="number" id="dd" value="1.5" step="0.1" min="0.1" inputmode="decimal">
      </div>
      <div>
        <label for="ll">관측선까지 L (m)</label>
        <input type="number" id="ll" value="3" step="0.5" min="0.5" inputmode="decimal">
      </div>
    </div>
    <div class="out">
      <div><span>파장 λ</span><b id="lam">—</b></div>
      <div><span>널 간격 Δy = λL/d</span><b id="dy">—</b></div>
    </div>
    <p class="tip" style="margin-top:12px">
      음속 343 m/s (20 °C) 기준입니다. 걸으면서 잰 널 간격을 여기 값과 비교하면
      음속을 <b>v = f λ</b> 로 역산할 수 있습니다.
    </p>
  </div>
</details>

<p class="tip">
  <b>스피커 배치</b> 두 스피커를 같은 높이, 같은 방향으로 놓고 간격 d를 재세요.
  스피커에서 L만큼 떨어진 선을 따라 걸으면 소리가 커졌다 작아졌다 합니다.<br><br>
  <b>널이 깊지 않다면</b> 좌우 음량을 조절해 두 스피커 소리를 같게 맞추세요.
  세기가 다르면 완전히 상쇄되지 않습니다.<br><br>
  <b>주의</b> 이어폰이나 블루투스가 연결되어 있으면 실험이 되지 않습니다.
  유선 분배기로 좌우를 각각 스피커에 연결하세요.
</p>

<script>
const $ = id => document.getElementById(id);
function banner(msg){
  const b = $('banner'); b.innerHTML = '';
  const d = document.createElement('div');
  d.className = 'banner'; d.textContent = msg; b.appendChild(d);
}
window.addEventListener('error', e => banner('오류: ' + e.message));

/* ══ 소리 ══════════════════════════════════════════════════
   발진기 하나에서 나온 신호를 좌우로 나눕니다. 같은 발진기라
   위상 관계가 흔들릴 여지가 없습니다.
   오른쪽에만 지연을 걸어 위상차를 만듭니다.
   순음에서는 지연 φ/(360f) 초가 곧 위상차 φ 입니다.        */
let ctx = null, osc = null, delayR = null, gL = null, gR = null;
let freq = 600, phase = 0, volL = 0.70, volR = 0.70;
let onL = false, onR = false, playedAt = 0;

function build(){
  if (ctx) return;
  ctx = new (window.AudioContext || window.webkitAudioContext)();
  osc = ctx.createOscillator();
  osc.type = 'sine';
  osc.frequency.value = freq;

  delayR = ctx.createDelay(0.02);
  gL = ctx.createGain(); gR = ctx.createGain();
  gL.gain.value = 0; gR.gain.value = 0;

  const merge = ctx.createChannelMerger(2);
  osc.connect(gL); gL.connect(merge, 0, 0);          // 왼쪽
  osc.connect(delayR); delayR.connect(gR);
  gR.connect(merge, 0, 1);                            // 오른쪽
  merge.connect(ctx.destination);

  applyPhase();
  osc.start();
}
function applyPhase(){
  if (!delayR) return;
  delayR.delayTime.setTargetAtTime(phase/360/freq, ctx.currentTime, 0.01);
}
function applyGain(){
  if (!ctx) return;
  const t = ctx.currentTime;
  gL.gain.setTargetAtTime(onL ? volL*0.5 : 0, t, 0.008);
  gR.gain.setTargetAtTime(onR ? volR*0.5 : 0, t, 0.008);
}
function setPlay(l, r){
  build();
  if (ctx.state === 'suspended') ctx.resume();
  onL = l; onR = r;
  if ((l || r) && !playedAt) playedAt = Date.now();
  if (!l && !r) playedAt = 0;
  applyGain();
  $('bL').classList.toggle('on', l && !r);
  $('bR').classList.toggle('on', r && !l);
  $('bBoth').classList.toggle('on', l && r);
  keepAwake();
}
$('bL').addEventListener('click', () => setPlay(true, false));
$('bR').addEventListener('click', () => setPlay(false, true));
$('bBoth').addEventListener('click', () => setPlay(true, true));
$('bStop').addEventListener('click', () => setPlay(false, false));

/* 오래 틀어두면 알려줍니다 */
setInterval(() => {
  if (playedAt && Date.now() - playedAt > 180000){
    banner('3분 넘게 재생 중입니다. 귀를 잠시 쉬게 해 주세요.');
    playedAt = Date.now();
  }
}, 5000);

let wl = null;
async function keepAwake(){
  try{ if ('wakeLock' in navigator && !wl){
    wl = await navigator.wakeLock.request('screen');
    wl.addEventListener('release', () => { wl = null; });
  }}catch(e){}
}

/* ══ 조절 ══════════════════════════════════════════════════ */
$('ph').addEventListener('input', e => {
  phase = +e.target.value; applyPhase(); showPhase();
});
$('phChips').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  phase = +b.dataset.p; $('ph').value = phase; applyPhase(); showPhase();
});
$('fr').addEventListener('input', e => {
  freq = +e.target.value;
  if (osc) osc.frequency.setTargetAtTime(freq, ctx.currentTime, 0.01);
  applyPhase(); showFreq();
});
$('frChips').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  freq = +b.dataset.f; $('fr').value = freq;
  if (osc) osc.frequency.setTargetAtTime(freq, ctx.currentTime, 0.01);
  applyPhase(); showFreq();
});
$('vl').addEventListener('input', e => { volL = e.target.value/100; $('lv').textContent = e.target.value; applyGain(); });
$('vr').addEventListener('input', e => { volR = e.target.value/100; $('rv').textContent = e.target.value; applyGain(); });

function showPhase(){
  $('pv').textContent = phase + '°';
  $('dv').textContent = phase + '°';
  for (const b of $('phChips').children) b.classList.toggle('on', +b.dataset.p === phase);
  const d = Math.min(phase, 360-phase);
  $('dtag').innerHTML = d < 15 ? '가운데에서<br>가장 크게 보강'
                     : d > 165 ? '가운데에서<br>완전히 상쇄'
                     : '무늬가<br>한쪽으로 이동';
}
function showFreq(){
  $('fv').textContent = freq + ' Hz';
  for (const b of $('frChips').children) b.classList.toggle('on', +b.dataset.f === freq);
  calc();
}
function calc(){
  const lam = 343/freq;
  const d = parseFloat($('dd').value) || 1;
  const L = parseFloat($('ll').value) || 1;
  const dy = lam*L/d;
  $('lam').textContent = lam.toFixed(3) + ' m';
  $('dy').textContent  = dy.toFixed(2) + ' m';
  $('dyShort').textContent = 'Δy ' + dy.toFixed(2) + ' m';
}
$('dd').addEventListener('input', calc);
$('ll').addEventListener('input', calc);

/* ══ 위상자와 파형 ═════════════════════════════════════════
   왼쪽: 같은 속도로 도는 두 벡터. 사잇각이 위상차입니다.
   오른쪽: 두 파동과 그 합. 합은 두 스피커에서 같은 거리인
          지점에서 실제로 들리는 파동입니다.
   보이라고 아주 느리게 돌립니다. 실제 진동은 훨씬 빠릅니다.  */
const cv = $('scope'), cx2 = cv.getContext('2d');
let dim = {w:1, h:180};
function fit(){
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const w = Math.max(cv.clientWidth, 1), h = 180;
  cv.width = Math.round(w*dpr); cv.height = Math.round(h*dpr);
  cv.style.height = h + 'px';
  cx2.setTransform(dpr, 0, 0, dpr, 0, 0);
  dim = {w:w, h:h};
}
fit();
if (window.ResizeObserver) new ResizeObserver(fit).observe(cv);
window.addEventListener('resize', fit);

function arrow(ctx, x0, y0, x1, y1, color){
  ctx.strokeStyle = color; ctx.lineWidth = 2.2; ctx.lineCap = 'round';
  ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
  const a = Math.atan2(y1-y0, x1-x0), s = 8;
  ctx.fillStyle = color; ctx.beginPath();
  ctx.moveTo(x1, y1);
  ctx.lineTo(x1 - s*Math.cos(a-0.4), y1 - s*Math.sin(a-0.4));
  ctx.lineTo(x1 - s*Math.cos(a+0.4), y1 - s*Math.sin(a+0.4));
  ctx.closePath(); ctx.fill();
}

function draw(now){
  const d = dim, c = cx2;
  c.clearRect(0, 0, d.w, d.h);
  const th = (now/4000)*Math.PI*2;          // 4초에 한 바퀴
  const ph = phase*Math.PI/180;

  /* ── 위상자 ── */
  const R = 58, cx = 12 + R + 8, cy = d.h/2;
  c.strokeStyle = '#DDE2DA'; c.lineWidth = 1;
  c.beginPath(); c.arc(cx, cy, R, 0, 6.2832); c.stroke();
  c.beginPath(); c.moveTo(cx-R, cy); c.lineTo(cx+R, cy);
  c.moveTo(cx, cy-R); c.lineTo(cx, cy+R); c.stroke();

  /* 사잇각 부채꼴 */
  if (phase > 0){
    c.fillStyle = 'rgba(30,35,32,.07)';
    c.beginPath(); c.moveTo(cx, cy);
    c.arc(cx, cy, R*0.42, -th, -(th-ph), true);
    c.closePath(); c.fill();
  }
  arrow(c, cx, cy, cx + R*Math.cos(th), cy - R*Math.sin(th), '#B23A2E');
  arrow(c, cx, cy, cx + R*Math.cos(th-ph), cy - R*Math.sin(th-ph), '#1D6E6E');

  /* ── 파형 ── */
  const x0 = cx + R + 26, x1 = d.w - 8, W = x1 - x0;
  if (W > 60){
    const mid = d.h/2, amp = d.h/5;
    c.strokeStyle = '#DDE2DA'; c.lineWidth = 1;
    c.beginPath(); c.moveTo(x0, mid); c.lineTo(x1, mid); c.stroke();

    const wave = (dphi, gain, color, width) => {
      c.strokeStyle = color; c.lineWidth = width; c.beginPath();
      for (let i = 0; i <= W; i++){
        const a = (i/W)*Math.PI*4;                 // 2주기
        const y = mid - Math.sin(a - dphi)*amp*gain;
        i ? c.lineTo(x0+i, y) : c.moveTo(x0+i, y);
      }
      c.stroke();
    };
    /* 합 (두 스피커에서 같은 거리인 지점) */
    c.strokeStyle = '#1E2320'; c.lineWidth = 2.4; c.beginPath();
    for (let i = 0; i <= W; i++){
      const a = (i/W)*Math.PI*4;
      const y = mid - (Math.sin(a) + Math.sin(a - ph))*amp*0.5;
      i ? c.lineTo(x0+i, y) : c.moveTo(x0+i, y);
    }
    c.stroke();
    wave(0,  1, '#B23A2E', 1.3);
    wave(ph, 1, '#1D6E6E', 1.3);

    /* 위상자와 같은 위치를 가리키는 커서 */
    const frac = ((th/(Math.PI*2)) % 2 + 2) % 2;
    const xc = x0 + (frac/2)*W;
    c.strokeStyle = '#AEB6AC'; c.lineWidth = 1; c.setLineDash([2,3]);
    c.beginPath(); c.moveTo(xc, mid-amp*2.1); c.lineTo(xc, mid+amp*2.1); c.stroke();
    c.setLineDash([]);
    const dot = (dphi, color) => {
      c.fillStyle = color; c.beginPath();
      c.arc(xc, mid - Math.sin(th - dphi)*amp, 3.4, 0, 6.2832); c.fill();
    };
    dot(0, '#B23A2E'); dot(ph, '#1D6E6E');

    c.fillStyle = '#8E968C'; c.font = '10px ui-monospace, monospace';
    c.fillText('합', x0 + 2, mid - amp*2.0);
  }
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);

showPhase(); showFreq();
</script>
</body>
</html>
